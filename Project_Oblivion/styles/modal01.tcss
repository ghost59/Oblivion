Screen{
    
    border: round;
}

#QuitScreen {
    align: center middle;
}

#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 11;
  
   
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

Button {
    width: auto;
    height: auto;
    border: round dodgerblue; 
}

Input{
    width: auto;
    border: round dodgerblue;
    height: auto; 
}

#app-grid{
    layout: grid; 
    grid-size: 2; 
    grid-columns: 1fr; 
    grid-rows: 1fr;
    background: #7D56F4;
    color: #180a41;
}

#atom_container > Static{
    
    color: auto;
    margin-bottom: 1; 
    padding: 1; 
}

#atom_container{
    width: 100%;
    height: 100%;
    row-span: 2; 
    
    border: round dodgerblue;
}

#top-right{
    height: 100;
    width: 100;
    layout: horizontal;
    
    border:$secondary round;
}



#bottom-right{
    height: 100%;
    layout: grid;
    grid-columns: 1fr; 
    grid-rows: 1fr;
    grid-gutter: 1; 
   
    border: round $secondary;
}

Header{
    height: 20%;
    width: 100%;
    border: round dodgerblue;
    background: #7D56F4;

}

#reads{
    height: 30; 
    width:70;
    border: round greenyellow;
    outline: round $accent;

}

#searchs{
    height: 100%; 
    width: 100%;
    layout: grid; 
    grid-size: 2; 
    grid-columns: 1fr; 
    grid-rows: 1fr;
    
    
}
#hor{
    height: 50%;
    width: 100%;
    padding: 1;
    border: round #7D56F4;
    
}

#whispers{
    color: #230e63;
}

#hor > Static{
    width: 100%; 
    height: 100%; 
    margin-right: 1; 
    
}

#querys > Static{
   
    color: auto;
    margin-bottom: 1; 
    padding: 1; 
}

#querys{
    width: 100%;
    height: 100%;
    row-span: 2; 
    border: round #7D56F4;
}

#Whisper{
    color: #2d0b92;
}

#bottom-right:hover{
    border: #7D56F4;

}



#top-right:hover{
    border: hsl(300, 100%, 85%);
}

#Atom_Enter{
    width: 30;
}

#atom_container:hover{
    border: hsl(300,100%,85%);
}

#query {
    width: 30;
}

Footer {
    background: #7D56F4;
}